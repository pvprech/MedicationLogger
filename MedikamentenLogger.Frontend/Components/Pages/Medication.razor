@page "/medication/{Id:int}"
@rendermode InteractiveServer

@using Clients
@using Models
@using MedikamentenLogger.Shared.Dtos.EntryDtos

@inject NavigationManager NavigationManager
@inject MedicationEntryService MedicationEntryService
@inject NavigationState NVState

@inject MedicationCardService CardService
@inject NavigationManager NavigationManager

@if (CardName is null || entries is null)
{
    <p>Loading Medication...</p>
}
else
{
    <div class="text-center mt-5">
        <h1>@CardName</h1>
    </div>

    <div class="card">
        <h2 class="text-center mb-2">Select Day</h2>

        <div class="drum">

            <div class="drum-sep"></div>

            <div class="drum-col">
                <div class="wheel-spacer"></div>
                @foreach (var entry in entries)
                {
                    <div class="wheel-item" @onclick="() => ToSelectedEntry(entry.Id)">
                        @entry.Date.ToString("dd.MM.yyyy")
                    </div>
                }
                <div class="wheel-spacer"></div>

            </div>

            <div class="drum-sep"></div>

        </div>
    </div>

    <div class="createBtn" @onclick="() => NewEntry()">
        <h3>+</h3>
    </div>

    <div class="backBtn" @onclick="() => ToHomePage()">
        <h3>&lt;</h3>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private List<PageEntryDto> entries = [];
    private string? CardName;

    protected override async Task OnInitializedAsync()
    {
        entries = [.. await MedicationEntryService.GetMedicationEntriesByMedicationId(Id)];
        CardName = CardService.GetMedicationCardByID(entries[0].MedicationId)!.Name ?? "Unbekannt";
    }

    private void ToSelectedEntry(int id)
    {
        NVState.SelectedEntry = entries!.First(entry => entry.Id == id);
        NavigationManager.NavigateTo($"/medication/entry/{id}");
    }

    private async Task NewEntry()
    {
        CreateEntryDto newEntry = new CreateEntryDto
        (
            Id, DateOnly.FromDateTime(DateTime.Today),
            0, 0, "Notizen"
        );

        EntryDetailsDto entry = (await MedicationEntryService.AddMedicationEntry(newEntry))!;
        entries.Add(new PageEntryDto(entry.Id, entry.MedicationId, entry.Date));
        ToSelectedEntry(entry.Id);
    }

    private void ToHomePage()
    {
        NavigationManager.NavigateTo("/");
    }
}