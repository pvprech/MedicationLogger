@using MedikamentenLogger.Frontend.Clients
@using MedikamentenLogger.Frontend.Components.Controls
@using MedikamentenLogger.Frontend.Models
@using MedikamentenLogger.Shared.Dtos.EntryDtos
@using MedikamentenLogger.Shared.Dtos.RatingDtos

@inject MedicationEntryService MedicationEntryService
@inject MedicationCardService CardService
@inject NavigationManager NavigationManager
@inject NavigationState NVState
@inject IJSRuntime JS

@rendermode InteractiveServer

@page "/medication/entry/{Id:int}"

@if (entry == null)
{
    <p>Loading...</p>
}
else
{
    <div class="text-center mt-5">
        <h5>@medicationName</h5>
    </div>

    <EditForm Model="@entry" FormName="medicationEntry" OnValidSubmit="HandleSubmit" class="p-4 pt-0 mt-4 center">
        <div class="starField">
            <label for="generalEffectiveness">General Effectiveness:</label>
            <InputStarRating id="generalEffectiveness" @bind-Value="entry.GeneralEffectiveness" />
        </div>

        <div class="starField">
            <label for="generalSideEffects">General Side Effects:</label>
            <InputStarRating id="generalSideEffects" @bind-Value="entry.GeneralSideEffects" />
        </div>

        @foreach (var starRating in entry.SpecificRatings)
        {
            <div class="starField">
                <label for="@starRating.Name">@starRating.Name:</label>
                <InputStarRating id="@starRating.Name" @bind-Value="starRating.Rating" />
            </div>
        }

        <div>
            <label for="userNote">Notes:</label>
            <InputTextArea @ref="textAreaRef" id="userNote" @bind-Value="entry.UserNote"
                           class="auto-grow form-control inputtextarea" />
        </div>

        <button type="submit" class="saveBtn mt-5">Save</button>

    </EditForm>

    <div class="backBtn" @onclick="() => ToLastPage()">
        <h3>&lt;</h3>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private InputTextArea? textAreaRef;

    private MedicationEntry? entry;
    private string medicationName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        PageEntryDto? pageEntry = NVState.SelectedEntry;
        OpenedEntryDto openedEntry = await MedicationEntryService.GetMedicationEntryByID(Id);

        if (openedEntry is null || pageEntry is null)
        {
            medicationName = "Unbekannt";
            return;
        }

        List<StarRating> starRatings = [];

        foreach (var rating in openedEntry.Ratings)
        {
            int id = 1;
            StarRating starRating = new StarRating
            {
                Id = id,
                Name = rating.Name,
                Rating = rating.Rating,
                DisplayOrder = rating.DisplayOrder
            };

            starRatings.Add(starRating);
            id++;
        }

        entry = new MedicationEntry
        {
            Id = pageEntry.Id,
            MedicationId = pageEntry.MedicationId,
            Date = pageEntry.Date,
            GeneralEffectiveness = openedEntry.GeneralEffectiveness,
            GeneralSideEffects = openedEntry.GeneralSideEffects,
            SpecificRatings = starRatings,
            UserNote = openedEntry.UserNote,
            ImagePaths = []
        };

        medicationName = CardService.GetMedicationCardByID(entry.MedicationId)?.Name ?? "Unbekannt";
    }

    // Note for me: please fix this inefficient crap
    private async Task HandleSubmit()
    {
        EntryDetailsDto entryDetails = await MedicationEntryService.GetEntryDetailsDto(Id);

        List<UpdateEntryRatingDto> updatedRatings = [];
        int ratingId = 0;
        foreach (var rating in entry!.SpecificRatings)
        {
            ratingId = entryDetails.SpecificRatings.First(e => e.Name == rating.Name).Id;
            UpdateEntryRatingDto updatedRating = new(ratingId, rating.Rating);
        }

        UpdateEntryDto updateEntryDto = new(
            entry.GeneralEffectiveness,
            entry.GeneralSideEffects,
            entry.UserNote,
            updatedRatings
        );

        await MedicationEntryService.UpdateMedicationEntry(Id, updateEntryDto);
        ToLastPage();
    }

    private void ToLastPage()
    {
        NavigationManager.NavigateTo(entry != null ? $"/medication/{entry.MedicationId}" : "/");
    }

    // idk bro just copied it
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && textAreaRef?.Element != null)
        {
            await JS.InvokeVoidAsync("initAutoGrow", textAreaRef.Element);
        }
    }
}